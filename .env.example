# Copy this file to .env and fill in the credentials for your providers.
# The QA model must support image input.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-your-key
LLM_QA_MODEL=google/gemini-3.1-flash-lite
LLM_CHAPTER_MODEL=google/gemini-3.1-flash-lite

# The ASR provider must support response_format=verbose_json with segments.
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_API_KEY=replace-with-your-key
ASR_MODEL=whisper-large-v3-turbo
ASR_LANGUAGE=zh

# Optional settings:
# TRANSCRIBE_WINDOW_SECONDS=300
# TRANSCRIBE_OVERLAP_SECONDS=30
# QA_HISTORY_MESSAGES=6
# CORS_ALLOW_ORIGINS=
